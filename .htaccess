# betagsf.sreeb.dev — beta staging config
# Deployed via hPanel Git, which clones the whole repository into the web root.
# That means repository files are web-reachable unless denied here.

# --- Keep the beta out of search results -------------------------------
# Third layer, alongside the noindex meta tag on all 20 pages and robots.txt.
# Applies to every response including images and CSS, which meta tags cannot cover.
<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
</IfModule>

# --- Password-protect the whole beta -----------------------------------
# The only airtight answer: robots.txt Disallow stops a compliant crawler
# fetching the page, so it never sees the noindex tag, and the bare URL can
# still surface. A 401 cannot be indexed at all. It also covers images, which
# LiteSpeed serves on a fast path that skips mod_headers entirely.
# .htpasswd lives OUTSIDE the web root - see DEPLOY.md section 5.
# TEMPORARILY DISABLED at Sree's request so the beta can be browsed without a
# password. .htpasswd is still on the server, so re-enabling is just deleting
# the four "# " prefixes below -- no need to recreate the credentials.
#
# While these lines are commented out the ONLY thing keeping this beta out of
# search results is robots.txt + the noindex meta tag + the X-Robots-Tag
# header -- and the header measurably does not reach images on this host, so
# every photograph is uncovered. Re-enable before sharing the URL anywhere.
# AuthType Basic
# AuthName "GoSports beta"
# AuthUserFile /home/u306132917/domains/betagsf.sreeb.dev/.htpasswd
# Require valid-user

# --- Deny repository files that are not part of the site ---------------
<FilesMatch "(^\.|\.md$|\.sh$|^LICENSE$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# --- Deny the .git and .github directories -----------------------------
# .git is left over from the old clone; .github holds the deploy workflow,
# which names the server IP, port and username. FilesMatch cannot catch
# .github/workflows/deploy.yml - it matches on basename, and "deploy.yml"
# looks like an ordinary file - so deny by path instead.
RedirectMatch 404 /\.git(hub)?(/|$)

# --- No directory listings ---------------------------------------------
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# --- Compression --------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript image/svg+xml
</IfModule>

# --- Caching ------------------------------------------------------------
# Goal: a deploy is visible on the next page load, everywhere, without anyone
# having to remember a manual step.
#   - HTML, CSS, JS, manifest, txt: "no-cache" = browsers and the Hostinger CDN
#     may keep a copy but must check with the server before using it. Unchanged
#     files come back as a tiny 304, so this costs a round trip, not a download.
#   - Images: 1 hour. mod_headers does not reach images on this host (LiteSpeed
#     fast path, see DEPLOY.md), so they are set via mod_expires only. A photo
#     replaced under the same filename shows within the hour.
# Anything not listed would fall back to Hostinger's 7-day default, which is
# what JS (served as application/x-javascript) and .webp were getting before.
# Hostinger serves .webmanifest as text/plain without this
AddType application/manifest+json .webmanifest

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                          "access plus 1 hour"
    ExpiresByType image/jpeg                "access plus 1 hour"
    ExpiresByType image/png                 "access plus 1 hour"
    ExpiresByType image/webp                "access plus 1 hour"
    ExpiresByType image/avif                "access plus 1 hour"
    ExpiresByType image/gif                 "access plus 1 hour"
    ExpiresByType image/svg+xml             "access plus 1 hour"
    ExpiresByType image/x-icon              "access plus 1 hour"
    ExpiresByType image/vnd.microsoft.icon  "access plus 1 hour"
    ExpiresByType text/html                 "access plus 0 seconds"
    ExpiresByType text/css                  "access plus 0 seconds"
    ExpiresByType application/javascript    "access plus 0 seconds"
    ExpiresByType application/x-javascript  "access plus 0 seconds"
    ExpiresByType text/javascript           "access plus 0 seconds"
    ExpiresByType application/manifest+json "access plus 0 seconds"
    ExpiresByType text/plain                "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(html?|css|js|webmanifest|txt)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# --- Security headers ---------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Note: HTTPS redirect is handled at the Hostinger edge (hcdn) and is
# deliberately not duplicated here, to avoid a redirect loop behind the CDN.
